    <!-- About -->
    <string name="about_title">About and safety</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_what_heading">What VisionNav is</string>
    <string name="about_what_body">VisionNav is a walking assistant for blind and low-vision people. It combines walking routes, live camera descriptions, and spoken and vibrating alerts.</string>
    <string name="about_safety_heading">Safety</string>
    <string name="about_limits_heading">Limitations</string>
    <string name="limit_not_detected">Stairs, doors and kerbs are not detected by the current model.</string>
    <string name="limit_distance">VisionNav does not measure distances to objects. Near and far are rough estimates from the camera image.</string>
    <string name="limit_signals">Pedestrian walk signals are not recognised.</string>
    <string name="limit_gps">GPS can be wrong by many metres, especially near tall buildings.</string>
    <string name="about_privacy_heading">Privacy</string>
    <string name="privacy_camera">Camera frames never leave this phone. No images are recorded or uploaded.</string>
    <string name="privacy_network">The internet is used only for maps, place search and routes.</string>
    <string name="privacy_log">The session log contains text only and stays on the phone unless you share it.</string>
    <string name="about_credits_heading">Open-source credits</string>
    <string name="credit_osm">Map data © OpenStreetMap contributors, available under the Open Database License.</string>
    <string name="credit_valhalla">Walking routes by the Valhalla routing engine, MIT License.</string>
    <string name="credit_photon">Place search by Photon, Apache License 2.0.</string>
    <string name="credit_yolo">Object detection model YOLOv8 by Ultralytics, licensed under AGPL-3.0. The model and its source are available from Ultralytics.</string>
    <string name="credit_android">Built with Android Jetpack, Kotlin, Hilt and LiteRT, Apache License 2.0.</string>

