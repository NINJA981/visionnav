    <!-- Onboarding -->
    <string name="onboarding_step">Step %1$d of %2$d</string>
    <string name="onboarding_welcome_title">Welcome to VisionNav</string>
    <string name="onboarding_welcome_body">VisionNav guides you on foot using speech and vibration. It plans walking routes, tells you where you are, and uses the phone camera to describe some of what is ahead, such as people, vehicles and benches.</string>
    <string name="onboarding_welcome_point_voice">Speak a command or use the large buttons. Every screen works with TalkBack.</string>
    <string name="onboarding_welcome_point_haptics">Turns and alerts also vibrate, so you can use VisionNav with speech muted.</string>
    <string name="onboarding_welcome_point_device">Camera images are processed on this phone and never uploaded.</string>
    <string name="onboarding_safety_title">Your safety comes first</string>
    <string name="onboarding_safety_body">VisionNav adds information. It does not replace your cane, guide dog, hearing or orientation and mobility training.</string>
    <string name="onboarding_safety_ack">I understand</string>
    <string name="onboarding_hold_title">How to hold the phone</string>
    <string name="onboarding_hold_body">Hold the phone upright in portrait, screen facing you, with the rear camera pointing forward.</string>
    <string name="hold_point_mount">A lanyard or chest mount is recommended. It keeps the camera steady and your hands available for your cane or guide dog.</string>
    <string name="hold_point_steady">Keep the phone still while checking traffic. Turning the phone makes the view unclear.</string>
    <string name="hold_point_lens">Keep the camera lens uncovered and clean.</string>
    <string name="hold_point_audio">Use one earbud or bone-conduction headphones so you can still hear the street.</string>
    <string name="onboarding_permissions_title">Permissions</string>
    <string name="onboarding_permissions_body">VisionNav asks for the permissions below. You can continue without them, but some features will not work.</string>
    <string name="onboarding_grant">Grant permissions</string>
    <string name="onboarding_grant_again">Request permissions again</string>
    <string name="onboarding_contacts_title">Emergency contacts</string>
    <string name="onboarding_contacts_body">Optional. When you confirm an SOS, VisionNav texts your location to these people. You can change them later in Settings.</string>
    <string name="onboarding_finish">Finish setup</string>
    <string name="onboarding_skip_contacts">Skip for now and finish</string>

    <!-- Safety statements (onboarding, About, crossing screen) -->
    <string name="safety_never_decides">VisionNav never decides when you should cross a road. That decision is always yours.</string>
    <string name="safety_ahead_only">The camera sees only what is in front of the phone. It cannot see behind or beside you.</string>
    <string name="safety_may_miss">Detection can miss vehicles, people and obstacles, especially in low light, rain or glare.</string>
    <string name="safety_silence">Silence from VisionNav does not mean nothing is there. Keep listening to your surroundings.</string>

